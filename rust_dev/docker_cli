#!/bin/sh

build_image() {
    docker build \
        --no-cache --progress plain \
        -t hedaz:rust_dev "$PWD"
}

run() {
    docker run -it \
        -v "$HOME"/workspace:"$HOME"/workspace \
        -w "$HOME"/workspace \
        hedaz:rust_dev
}

help() 
{
    echo -e "help"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --help)     help; exit 0 ;;
        --build)
            read -p "Are you sure you want to build the image? (Y/n): " confirm
            case "$confirm" in
                [Yy]* )     build_image;;
                * )         echo "canceled.";;
            esac
            exit 0 ;;
        --run)      run; exit 0 ;;
        *)          echo "Unknown option: $1"; exit -22 ;;
    esac
done
